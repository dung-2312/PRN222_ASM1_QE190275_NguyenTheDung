@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="card-pro p-5 text-center my-5 mx-auto" style="max-width: 540px;">
    <div class="display-1 text-danger mb-3"><i class="bi bi-shield-slash"></i></div>
    <h3 class="fw-bold mb-2">Từ chối truy cập</h3>
    <p class="text-muted mb-4">Tài khoản của bạn không có quyền truy cập vào chức năng này.</p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="NewsArticle" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-newspaper me-1"></i>Về Trang Bản tin
        </a>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-light border">
            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập tài khoản khác
        </a>
    </div>
</div>
