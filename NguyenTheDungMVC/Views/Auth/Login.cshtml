@model NguyenTheDungMVC.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-wrapper">
    <div class="col-lg-9 col-xl-8">
        <div class="row g-0 auth-card">
            <!-- Left Editorial Branding Panel -->
            <div class="col-md-5 auth-side-banner d-none d-md-flex">
                <div>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: rgba(255,255,255,0.12); font-size: 0.8rem;">
                        <i class="bi bi-stars text-info"></i>
                        <span>Cổng Thông tin Đại học FPT</span>
                    </div>
                    <h3 class="fw-bold mb-3">Trung tâm Tin tức &amp; Truyền thông FU</h3>
                    <p class="text-white-50 small mb-0" style="line-height: 1.7;">
                        Nền tảng quản trị và xuất bản tập trung các thông báo học thuật, công trình nghiên cứu khoa học, hoạt động sinh viên và mạng lưới cựu sinh viên.
                    </p>
                </div>
                <div class="small text-white-50">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shield-check text-info"></i>
                        <span>Phân quyền truy cập theo vai trò</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-lightning-charge text-info"></i>
                        <span>Quy trình xuất bản tin tức trực tuyến</span>
                    </div>
                </div>
            </div>

            <!-- Right Login Form -->
            <div class="col-md-7 p-4 p-lg-5 bg-white">
                <div class="mb-4">
                    <h4 class="fw-bold mb-1">Chào mừng trở lại</h4>
                    <p class="text-muted small mb-0">Đăng nhập bằng tài khoản hệ thống của bạn để tiếp tục</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger border-0 rounded-3 py-2 small d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>@ViewBag.ErrorMessage</span>
                    </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-uppercase text-secondary">Địa chỉ Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted pe-2"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 ps-1" placeholder="tenban@gmail.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold small text-uppercase text-secondary">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted pe-2"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control border-start-0 ps-1" placeholder="Nhập mật khẩu của bạn" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập Hệ thống
                        </button>
                        <a asp-controller="NewsArticle" asp-action="Index" class="btn btn-light border text-secondary py-2">
                            <i class="bi bi-globe2 me-1"></i>Xem Tin tức Công khai (Không cần đăng nhập)
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
