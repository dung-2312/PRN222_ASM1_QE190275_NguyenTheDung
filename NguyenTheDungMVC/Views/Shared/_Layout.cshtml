@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Options
@using NguyenTheDungMVC.Models.Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject IOptions<RoleSettingsOptions> RoleOptionsAccessor
@{
    var roleSettings = RoleOptionsAccessor.Value;
    int? role = HttpContextAccessor.HttpContext?.Session.GetInt32(SessionKeys.AccountRole);
    string? accountName = HttpContextAccessor.HttpContext?.Session.GetString(SessionKeys.AccountName);
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string roleLabel = "Khách";
    if (role.HasValue)
    {
        if (role.Value == roleSettings.AdminRole) roleLabel = "Quản trị viên";
        else if (role.Value == roleSettings.StaffRole) roleLabel = "Nhân viên";
        else if (role.Value == roleSettings.LecturerRole) roleLabel = "Giảng viên";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Quản lý Tin tức FU</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-executive sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="NewsArticle" asp-action="Index">
                    <span class="brand-icon-box"><i class="bi bi-newspaper"></i></span>
                    <span>FU News<span class="text-info fw-normal">Hub</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "NewsArticle" && currentAction == "Index" ? "active" : "")"
                               asp-controller="NewsArticle" asp-action="Index">
                                <i class="bi bi-compass me-1"></i>Bản tin
                            </a>
                        </li>

                        @if (role.HasValue && role.Value == roleSettings.AdminRole)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "SystemAccount" && currentAction == "Index" ? "active" : "")"
                                   asp-controller="SystemAccount" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Quản lý Tài khoản
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "NewsArticle" && currentAction == "Report" ? "active" : "")"
                                   asp-controller="NewsArticle" asp-action="Report">
                                    <i class="bi bi-graph-up-arrow me-1"></i>Báo cáo Thống kê
                                </a>
                            </li>
                        }

                        @if (role.HasValue && role.Value == roleSettings.StaffRole)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "NewsArticle" && currentAction == "Manage" ? "active" : "")"
                                   asp-controller="NewsArticle" asp-action="Manage">
                                    <i class="bi bi-journal-richtext me-1"></i>Quản lý Bài viết
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Category" ? "active" : "")"
                                   asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-1"></i>Danh mục
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Tag" ? "active" : "")"
                                   asp-controller="Tag" asp-action="Index">
                                    <i class="bi bi-tags me-1"></i>Nhãn (Tags)
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "NewsArticle" && currentAction == "History" ? "active" : "")"
                                   asp-controller="NewsArticle" asp-action="History">
                                    <i class="bi bi-clock-history me-1"></i>Lịch sử Bài đăng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "SystemAccount" && currentAction == "Profile" ? "active" : "")"
                                   asp-controller="SystemAccount" asp-action="Profile">
                                    <i class="bi bi-person-vcard me-1"></i>Hồ sơ Cá nhân
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (role.HasValue)
                        {
                            <div class="user-pill">
                                <i class="bi bi-person-check-fill text-info"></i>
                                <span>@accountName</span>
                                <span class="badge bg-info text-dark rounded-pill ms-1">@roleLabel</span>
                            </div>
                            <a class="btn btn-outline-light btn-sm px-3" asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 rounded-4 shadow-sm alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 rounded-4 shadow-sm alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white py-3 text-muted mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center small">
            <div>
                <i class="bi bi-mortarboard-fill text-primary me-1"></i>
                <strong>Hệ thống Quản lý Tin tức Đại học FPT</strong> &mdash; Cổng Thông tin Điện tử
            </div>
            <div class="text-secondary">
                ASP.NET Core MVC &bull; Kiến trúc 3 Tầng (3-Layer Architecture)
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
